{
  "name": "@advance/intercom-global",
  "version": "2.0.0",
  "description": "Universal Cross-IDE & Cross-Harness Intercom, Interruption & Agent Communication Framework",
  "main": "src/index.js",
  "bin": {
    "intercom": "./bin/intercom.js",
    "intercom-wake": "./bin/intercom-wake.js",
