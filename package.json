  },
  "files": [
    "bin",
    "src",
    "skills",
    "docs",
    "install.ps1",
    "install.sh",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"test/unit/*.test.js\" \"test/helpers/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:all": "npm test && node test/empirical_adversarial_m2.js && node test/empirical_adversarial_m3.js && node test/e2e-opencode-hermes.js",
    "start": "node bin/intercom.js daemon start",
    "daemon": "node bin/intercom.js daemon",
    "doctor": "node bin/intercom.js doctor",
    "mcp": "node bin/intercom-mcp.js",
    "peers": "node bin/intercom.js peers",
    "sync": "node scripts/live-scrape-sync.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suran123s/intercom-global.git"
  },
  "bugs": {
